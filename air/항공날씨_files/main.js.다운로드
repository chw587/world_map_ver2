    var treeStructure = {
        treeMenu : function(){
            var mainMenu = $("#treeMenu");
            var btnOpen = $("<button type='button' class='open'>서브 메뉴 열기</button>");
            mainMenu.find("li:has(ul)").prepend(btnOpen);
