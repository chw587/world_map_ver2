            var subMenu = $(this).parent().find(" > ul");
            if(subMenu.css("display") == "none"){
                subMenu.slideDown(500);
                $(this).text("서브 메뉴 닫기").addClass("close").removeClass("open");
            } else {
                subMenu.slideUp(500);
                $(this).text("서브 메뉴 열기").addClass("open").removeClass("close");
