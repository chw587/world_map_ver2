	               	// 2025-07-30 고경환 추가 퀵메뉴 2단 메뉴 클릭시 기존 열려있던 메뉴 닫음 처리
                	$('#treeMenu>li>ul>li>ul').each((index, item) => {			                		
	                	if($(item).css("display") != "none"){
	                		$(item).slideUp(500);
	                		$(item).parent().find('button').text("서브 메뉴 열기").addClass("open").removeClass("close");
	                	}
	                })
	                
	                subMenu.slideDown(500);
	                $(this).prev().text("서브 메뉴 닫기").addClass("close").removeClass("open");
	            } else {
	                subMenu.slideUp(500);
	                $(this).prev().text("서브 메뉴 열기").addClass("open").removeClass("close");
	            }
	            return false;
            });
        },
        treeStatus : function(status){
            var mainMenu = $("#treeMenu");
            if(status == true){
            	mainMenu.find("ul").hide();
            } else {
            	mainMenu.find('ul').show();
            }
            
            // 2025-09-15 고경환 퀵메뉴 중 운항지원 하위 메뉴 페이지와 같은 url 메뉴 펼쳐져있도록 추가
            let selLink = mainMenu.find('> li > ul > li > ul > li > a');
            selLink.each((index, item)=>{
            	
            	if(item.href == window.location.href){
            		$(item).parent().parent().parent().parent().show();
            		
            		return false;
            	} else {
            		$(item).parent().parent().parent().parent().hide();
            	}
            })
            
