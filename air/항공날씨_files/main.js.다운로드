    var input = $('.validate-input input, .validate-input textarea');

    $('.validate-form').on('submit',function(){
        var check = true;

        for(var i=0; i<input.length; i++) {
            if(validate(input[i]) == false){
                showValidate(input[i]);
                check=false;
            }
        }

        return check;
    });


    $(input).each(function(){
        $(this).focus(function(){
           hideValidate(this);
        });
