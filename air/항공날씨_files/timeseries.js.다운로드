	function showWeeklyInfo() {
		if(isWwisOnly) return;
		var $infoWrapper = $wrapper.find('.ts-info-weekly');
		$infoWrapper.css({
			'left': tsHourlyBodyInnerWidth + 'px',
			'width': tsWeeklyBodyInnerWidth + 'px',
			'display': 'flex',
		});
	}
